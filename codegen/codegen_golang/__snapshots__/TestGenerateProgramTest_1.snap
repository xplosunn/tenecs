package main

import (
    "fmt"
    "reflect"
)

func test__helloWorld() any {
    return func(generics1 any) any {
        return map[string]any{"$type": "String", "value": "hello world!"}
    }
}
func test__syntheticName_0() any {
    return tenecs_test__UnitTestSuite().(func(any, any, any) any)([]any{}, map[string]any{"$type": "String", "value": "My Tests"}, func(generics1 any, _registry any) any {
        return _registry.(map[string]any)["_test"].(func(any, any, any) any)([]any{}, map[string]any{"$type": "String", "value": "hello world function"}, test__testCaseHelloworld())
    })
}
func test__syntheticName_1() any {
    return tenecs_test__UnitTest().(func(any, any, any) any)([]any{}, map[string]any{"$type": "String", "value": "unitHello"}, test__testCaseHelloworld())
}
func test__syntheticName_2() any {
    return tenecs_test__GoIntegrationTest().(func(any, any, any, any) any)([]any{}, map[string]any{"$type": "String", "value": "no_dependencies"}, map[string]any{"$type": "String", "value": "integration test"}, func(generics1 any, _testkit any, _runtime any) any {
        return _testkit.(map[string]any)["_assert"].(map[string]any)["_equal"].(func(any, any, any) any)([]any{"String"}, map[string]any{"$type": "String", "value": "hello world!"}, map[string]any{"$type": "String", "value": "hello world!"})
    })
}
func test__testCaseHelloworld() any {
    return func(generics1 any, _testkit any) any {
        var _result any = test__helloWorld().(func(any) any)([]any{})
        _ = _result
        var _expected any = map[string]any{"$type": "String", "value": "hello world!"}
        _ = _expected
        return _testkit.(map[string]any)["_assert"].(map[string]any)["_equal"].(func(any, any, any) any)([]any{"String"}, _result, _expected)
    }
}

func tenecs_test__GoIntegrationTest() any {
    return func(generics any, _dependsOnVersionOf any, _name any, _theTest any) any {
        return map[string]any{
            "generics":            generics,
            "_dependsOnVersionOf": _dependsOnVersionOf,
            "_name":               _name,
            "_theTest":            _theTest,
        }
    }
}
func tenecs_test__GoIntegrationTestKit() any {
    return func(generics any, _assert any) any {
        return map[string]any{
            "generics": generics,
            "_assert":  _assert,
        }
    }
}
func tenecs_test__UnitTest() any {
    return func(generics any, _name any, _theTest any) any {
        return map[string]any{
            "generics": generics,
            "_name":    _name,
            "_theTest": _theTest,
        }
    }
}
func tenecs_test__UnitTestKit() any {
    return func(generics any, _assert any, _ref any) any {
        return map[string]any{
            "generics": generics,
            "_assert":  _assert,
            "_ref":     _ref,
        }
    }
}
func tenecs_test__UnitTestRegistry() any {
    return func(generics any, _test any) any {
        return map[string]any{
            "generics": generics,
            "_test":    _test,
        }
    }
}
func tenecs_test__UnitTestSuite() any {
    return func(generics any, _name any, _tests any) any {
        return map[string]any{
            "generics": generics,
            "_name":    _name,
            "_tests":   _tests,
        }
    }
}

func main() {
    runTests([]any{test__syntheticName_0()}, []any{test__syntheticName_1()}, []any{test__syntheticName_2()})
}

type testSummaryStruct struct {
    runTotal              int
    runOk                 int
    runFail               int
    cachedUnitTestOk      int
    cachedUnitTestSuiteOk int
}

var testSummary = testSummaryStruct{}

func runTests(implementingUnitTestSuite []any, implementingUnitTest []any, implementingGoIntegrationTest []any) {
    registry := createTestRegistry()

    if len(implementingUnitTest) > 0 {
        fmt.Printf("unit tests:\n")
    }
    for _, implementation := range implementingUnitTest {
        registry.(map[string]any)["_test"].(func(any, any, any) any)([]any{}, implementation.(map[string]any)["_name"], implementation.(map[string]any)["_theTest"])
    }

    for _, implementation := range implementingUnitTestSuite {
        fmt.Println(implementation.(map[string]any)["_name"].(map[string]any)["value"].(string) + ":")
        implementation.(map[string]any)["_tests"].(func(any, any) any)([]any{}, registry)
    }

    if len(implementingGoIntegrationTest) > 0 {
        fmt.Printf("integration tests:\n")
    }
    for _, implementation := range implementingGoIntegrationTest {
        r := runtime()
        testkit := createGoIntegrationTestKit()
        registry.(map[string]any)["_test"].(func(any, any, any) any)([]any{}, implementation.(map[string]any)["_name"], func(_ any, _ any) any {
            implementation.(map[string]any)["_theTest"].(func(any, any, any) any)([]any{}, testkit, r)
            return nil
        })
    }

    fmt.Printf("\nRan a total of %d tests\n", testSummary.runTotal)
    fmt.Printf("  * %d succeeded\n", testSummary.runOk)
    fmt.Printf("  * %d failed\n", testSummary.runFail)
    if testSummary.cachedUnitTestOk > 0 {
        fmt.Printf("Skipped %d successful unit tests cached\n", testSummary.cachedUnitTestOk)
    }
    if testSummary.cachedUnitTestSuiteOk > 0 {
        fmt.Printf("Skipped %d successful unit test suites cached\n", testSummary.cachedUnitTestSuiteOk)
    }
}

func createGoIntegrationTestKit() any {
    assert := map[string]any{
        "_equal": func(generics any, expected any, value any) any {
            if !reflect.DeepEqual(value, expected) {
                panic(testEqualityErrorMessage(generics, value, expected))
            }
            return nil
        },
        "_fail": func(generics any, message any) any {
            panic("@codepointtodo" + ": " + message.(map[string]any)["value"].(string))
        },
    }

    testkit := map[string]any{
        "_assert": assert,
    }
    return testkit
}

func createTestRegistry() any {
    assert := map[string]any{
        "_equal": func(generics any, expected any, value any) any {
            if !reflect.DeepEqual(value, expected) {
                panic(testEqualityErrorMessage(generics, value, expected))
            }
            return nil
        },
        "_fail": func(generics any, message any) any {
            panic("@codepointtodo" + ": " + message.(map[string]any)["value"].(string))
        },
    }

    refCreator := map[string]any{
        "_new": func(generics any, value any) any {
            var ref any = value
            return map[string]any{
                "_get": func(generics any) any {
                    return ref
                },
                "_set": func(generics any, value any) any {
                    ref = value
                    return nil
                },
                "_modify": func(generics any, f any) any {
                    ref = f.(func(any) any)(ref)
                    return nil
                },
            }
        },
    }

    testkit := map[string]any{
        "_assert": assert,
        "_ref":    refCreator,
    }

    return map[string]any{
        "_test": func(generics any, name any, theTest any) any {
            testName := name.(map[string]any)["value"].(string)
            testFunc := theTest.(func(any, any) any)
            testSuccess := true
            defer func() {
                errMsg := "could not print the failure"
                if err := recover(); err != nil {
                    testSuccess = false
                    errMsg = err.(string)
                }
                testResultString := "[\u001b[32mOK\u001b[0m]"
                if !testSuccess {
                    testResultString = "[\u001b[31mFAILURE\u001b[0m]"
                    testSummary.runFail += 1
                } else {
                    testSummary.runOk += 1
                }
                fmt.Printf("  %s %s\n", testResultString, testName)
                if !testSuccess {
                    fmt.Printf("    %s\n", errMsg)
                }
                testSummary.runTotal += 1
            }()

            return testFunc([]any{}, testkit)
        },
    }
}

func testEqualityErrorMessage(generics any, value any, expected any) string {
    return fmt.Sprintf("@codepointtodo: %+v is not equal to %+v", expected, value)
}

func runtime() map[string]any {
    log := func(generics any, msg any) any {
        println(msg.(map[string]any)["value"].(string))
        return nil
    }
    console := map[string]any{
        "_log": log,
    }
    refCreator := map[string]any{
        "_new": func(generics any, value any) any {
            var ref any = value
            return map[string]any{
                "_get": func(generics any) any {
                    return ref
                },
                "_set": func(generics any, value any) any {
                    ref = value
                    return nil
                },
                "_modify": func(generics any, f any) any {
                    ref = f.(func(any) any)(ref)
                    return nil
                },
            }
        },
    }
    runtime := map[string]any{
        "_console": console,
        "_ref":     refCreator,
    }
    return runtime
}
